# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/llm_service

# Gateway URL
GATEWAY_URL=http://localhost:8000

# Development Mode - Allow localhost requests without API keys
# Set to 'true' for local development to bypass API key authentication
# WARNING: Never enable this in production!
ALLOW_LOCALHOST_BYPASS=true

# For Docker Compose, use:
# MONGODB_URI=mongodb://mongo:27017/llm_service
# GATEWAY_URL=http://gateway:8000
