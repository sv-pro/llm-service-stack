# AI Aikido Gateway - Docker Environment Configuration
# Copy this file to .env.docker and fill in your actual values

# ==============================================
# LLM API KEYS (REQUIRED)
# ==============================================

# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Optional, but recommended)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==============================================
# MODEL CONFIGURATION
# ==============================================

# Default models for classification and routing
CLASSIFIER_MODEL=claude-3-haiku-20240307
CLASSIFIER_MAX_TOKENS=100
CHEAP_MODEL=claude-3-haiku-20240307
EXPENSIVE_MODEL=gpt-4-turbo-preview

# ==============================================
# DOCKER-SPECIFIC CONFIGURATION
# ==============================================

# Gateway URL for dashboard (for production)
# In development: http://localhost:8000
# In production: https://your-domain.com or http://your-server-ip:8000
GATEWAY_URL=http://localhost:8000

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database path (automatically set in docker-compose)
# Don't change this unless you know what you're doing
DB_PATH=/app/data

# Gateway host (should remain 0.0.0.0 for Docker)
GATEWAY_HOST=0.0.0.0

# ==============================================
# DEVELOPMENT SETTINGS (for docker-compose.dev.yml)
# ==============================================

# Python path (for development hot reload)
PYTHONPATH=/app

# ==============================================
# SECURITY NOTES
# ==============================================

# 1. Never commit this file with real API keys to version control
# 2. In production, consider using Docker secrets instead of environment variables
# 3. Set spending limits in your OpenAI/Anthropic dashboards
# 4. Monitor usage regularly through the dashboard

# ==============================================
# USAGE EXAMPLES
# ==============================================

# Development:
#   cp .env.docker.example .env.docker
#   # Edit .env.docker with your keys
#   docker-compose -f docker-compose.yml -f docker-compose.dev.yml up

# Production:
#   cp .env.docker.example .env.docker
#   # Edit .env.docker with your keys and production settings
#   docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d