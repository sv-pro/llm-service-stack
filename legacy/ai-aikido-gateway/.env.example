# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO

# Classifier Configuration (which cheap model to use for classification)
CLASSIFIER_MODEL=claude-3-haiku-20240307
CLASSIFIER_MAX_TOKENS=100

# Routing Configuration
CHEAP_MODEL=claude-3-haiku-20240307
EXPENSIVE_MODEL=gpt-4-turbo-preview

# Optional: Database (for future use)
# DATABASE_URL=postgresql://user:pass@localhost:5432/aikido

# Optional: Redis (for caching / telemetry fan-out)
# REDIS_URL=redis://localhost:6379/0

# Re^Re Demo Telemetry (set to true to enable dashboard demo streaming)
RE_RE_DEMO_ENABLED=false
# RE_RE_TELEMETRY_REDIS_URL=redis://localhost:6379/0
# RE_RE_TELEMETRY_CHANNEL=re-re.telemetry
